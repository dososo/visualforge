          "type": "string",
          "enum": [
            "locked",
            "unlocked"
          ]
        },
        "palette": {
          "type": "string",
          "enum": [
            "locked",
            "unlocked"
          ]
        },
        "material": {
          "type": "string",
          "enum": [
            "locked",
            "unlocked"
          ]
